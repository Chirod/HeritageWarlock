WHITESPACE = _{" " | "\n"}
GREEN_MANA = {"{G}"}
BLUE_MANA = {"{U}"}
WHITE_MANA = {"{W}"}
BLACK_MANA = {"{B}"}
RED_MANA = {"{R}"}
COLORLESS_MANA = {"{C}"}
NON_GENERIC_MANA = _{ GREEN_MANA | BLUE_MANA | WHITE_MANA | BLACK_MANA | RED_MANA | COLORLESS_MANA }
TAP = {"{T}"}
NUMBER = {(ASCII_NONZERO_DIGIT ~ ASCII_DIGIT+) | ASCII_DIGIT}
GENERIC_MANA = {"{" ~ NUMBER ~ "}"}
MANA_COST = { (GENERIC_MANA | NON_GENERIC_MANA)+ }
ACTIVATED_ABILITY_COST = {(MANA_COST | TAP)+}
ACTIVATED_ABILITY = {ACTIVATED_ABILITY_COST ~ ":" ~ ACTION ~ "."}

ANY_TARGET = { "any target" }
TARGET = { ANY_TARGET }

CARDNAME = { PEEK }

DAMAGE_SOURCE = { CARDNAME }
ACTION = { ADD_MANA | DEAL_DAMAGE_TARGET }
ADD_MANA = { ("Add" | "add") ~ NON_GENERIC_MANA+}
DEAL_DAMAGE_TARGET = { DAMAGE_SOURCE ~ "deals" ~ NUMBER ~ "damage to" ~ TARGET }

PERMANENT_CARD_TEXT = { (ACTIVATED_ABILITY)+ }
SORCERY_CARD_TEXT = { (ACTION ~ ".")* }

LEGENDARY = { "Legendary" }
BASIC = { "Basic" }
WORLD = { "World" }

SUPER_TYPE = { "Legendary" | "Basic" | "World" }

INSTANT = { "Instant" }
ARTIFACT = { "Artifact" }
ENCHANTMENT = { "Enchantment" }
LAND = { "Land" }
PLANESWALKER = { "Planeswalker" }
SORCERY = { "Sorcery" }
BATTLE = { "Battle" }
KINDRED = { "Kindred" }
CREATURE = { "Creature" }

TYPE = { INSTANT | ARTIFACT | ENCHANTMENT | LAND | PLANESWALKER | SORCERY | BATTLE | KINDRED | CREATURE }

BEAST = { "Beast" }
BIRD = { "Bird" }
CAT = { "Cat" }
DOG = { "Dog" }
DRAGON = { "Dragon" }
ELEMENTAL = { "Elemental" }
CREATURE_TYPE = { BEAST | BIRD | CAT | DOG | DRAGON | ELEMENTAL }

FOREST = { "Forest" }
ISLAND = { "Island" }
SWAMP = { "Swamp" }
MOUNTAIN = { "Mountain" }
PLAINS = { "Plains" }

LAND_TYPE = { FOREST | ISLAND | SWAMP | MOUNTAIN | PLAINS }

TYPE_LINE = { SUPER_TYPE* ~ TYPE* ~ "—"? ~ CREATURE_TYPE* }

ASCII_WORD = @{ ASCII_ALPHANUMERIC+ }
CARD_NAME = @{ ASCII_WORD ~ (" " ~ ASCII_WORD) }

FULL_CARD = { PUSH(CARD_NAME) ~ MANA_COST? ~ TYPE_LINE ~ (PERMANENT_CARD_TEXT | SORCERY_CARD_TEXT)}
